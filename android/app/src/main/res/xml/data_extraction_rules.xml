<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The settings store holds the API token: keep it out of cloud backups.
     A direct device-to-device transfer still moves it to the user's new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
</data-extraction-rules>
