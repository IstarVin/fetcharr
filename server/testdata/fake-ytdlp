#!/usr/bin/env python3
"""Fake yt-dlp for fetcharr server tests. See testdata/README.md."""
import json
import os
import signal
import sys
import time

FAKE_VERSION = "2099.01.01"
TOTAL_BYTES = 4 * 1024 * 1024
TICKS = 20


def on_term(_signum, _frame):
    # Exit promptly, leaving the .part file behind (like a killed yt-dlp).
    os._exit(143)


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)

# Options that consume a following value (subset of yt-dlp's CLI).
VALUE_OPTS = {
    "-o", "--output", "-P", "--paths", "-f", "--format", "--merge-output-format",
    "--add-header", "--progress-template", "--print", "-S", "--format-sort",
    "--proxy", "--cookies", "--user-agent", "--referer", "-r", "--limit-rate",
    "--retries", "-R", "--sub-langs", "--extractor-args", "--downloader",
}


def parse(argv):
    opts = {"headers": [], "positional": []}
    i = 0
    after_dd = False
    while i < len(argv):
        a = argv[i]
        if after_dd:
            opts["positional"].append(a)
        elif a == "--":
            after_dd = True
        elif a == "--version":
            opts["version"] = True
        elif a in ("-U", "--update"):
            opts["update"] = True
        elif a in VALUE_OPTS and i + 1 < len(argv):
            v = argv[i + 1]
            i += 1
            if a in ("-o", "--output"):
                opts["output"] = v
            elif a in ("-P", "--paths"):
                opts["paths"] = v
            elif a == "--progress-template":
                opts["template"] = v
            elif a == "--print":
                opts["print"] = v
            elif a == "--add-header":
                opts["headers"].append(v)
            elif a == "--merge-output-format":
                opts["merge"] = v
        elif a.startswith("-"):
            pass  # boolean flag or unknown extra arg
        else:
            opts["positional"].append(a)
        i += 1
    return opts


def render(template, prog):
    """Substitute %(progress.key)s/d/f/j and %(progress)j like yt-dlp."""
    if template.startswith("download:"):
        template = template[len("download:"):]
    out = []
    i = 0
    while i < len(template):
        if template.startswith("%(", i):
            end = template.find(")", i)
            if end != -1 and end + 1 < len(template):
                field = template[i + 2:end]
                conv = template[end + 1]
                val = prog
                if field != "progress":
                    key = field.split(".", 1)[1] if field.startswith("progress.") else field
                    val = prog.get(key)
                if conv == "j":
                    out.append(json.dumps(val))
                elif val is None:
                    out.append("None")
                elif conv == "d":
                    out.append(str(int(val)))
                else:
                    out.append(str(val))
                i = end + 2
                continue
        out.append(template[i])
        i += 1
    return "".join(out)


def main():
    argv = sys.argv[1:]
    opts = parse(argv)
    if opts.get("version"):
        print(FAKE_VERSION)
        return 0
    if opts.get("update"):
        print("Available version: %s, Current version: %s" % (FAKE_VERSION, FAKE_VERSION))
        print("yt-dlp is up to date (%s)" % FAKE_VERSION)
        return 0

    if not opts["positional"]:
        sys.stderr.write("ERROR: you must provide at least one URL\n")
        return 2
    url = opts["positional"][-1]

    if "fail" in url:
        print("[generic] Extracting URL: " + url)
        sys.stderr.write("ERROR: [generic] simulated failure\n")
        return 1

    out_tmpl = opts.get("output", "media.%(ext)s")
    if opts.get("paths"):
        p = opts["paths"]
        if ":" in p and p.split(":", 1)[0] in ("home", "temp"):
            p = p.split(":", 1)[1]
        out_tmpl = os.path.join(p, out_tmpl)
    ext = opts.get("merge") or "mp4"
    final = out_tmpl.replace("%(ext)s", ext)
    part = final + ".part"
    os.makedirs(os.path.dirname(os.path.abspath(final)), exist_ok=True)

    try:
        duration = float(os.environ.get("FAKE_YTDLP_DURATION", "4"))
    except ValueError:
        duration = 4.0

    print("[generic] Extracting URL: " + url, flush=True)
    print("[info] fake: 1 format(s) selected", flush=True)
    print("[download] Destination: " + final, flush=True)

    start = os.path.getsize(part) if os.path.exists(part) else 0
    start = min(start, TOTAL_BYTES)
    if start:
        print("[download] Resuming download at byte %d" % start, flush=True)
    chunk = TOTAL_BYTES // TICKS
    remaining_ticks = max(1, round((TOTAL_BYTES - start) / chunk))
    delay = duration / TICKS if duration > 0 else 0
    template = opts.get("template")

    downloaded = start
    with open(part, "ab") as fh:
        for _ in range(remaining_ticks):
            n = min(chunk, TOTAL_BYTES - downloaded)
            if n <= 0:
                break
            fh.write(b"\0" * n)
            fh.flush()
            downloaded += n
            if delay:
                time.sleep(delay)
            speed = (chunk / delay) if delay else float(chunk * 100)
            prog = {
                "status": "downloading",
                "downloaded_bytes": downloaded,
                "total_bytes": TOTAL_BYTES,
                "total_bytes_estimate": None,
                "speed": round(speed, 1),
                "eta": max(0, round((TOTAL_BYTES - downloaded) / speed)),
                "elapsed": 0.0,
                "filename": final,
            }
            if template:
                print(render(template, prog), flush=True)
            else:
                print("[download] %5.1f%% of %d bytes" % (100.0 * downloaded / TOTAL_BYTES, TOTAL_BYTES), flush=True)
    os.replace(part, final)
    if template:
        done = {
            "status": "finished", "downloaded_bytes": TOTAL_BYTES, "total_bytes": TOTAL_BYTES,
            "total_bytes_estimate": None, "speed": None, "eta": 0, "elapsed": duration, "filename": final,
        }
        print(render(template, done), flush=True)
    if opts.get("print", "").endswith("filepath"):
        print(final, flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
